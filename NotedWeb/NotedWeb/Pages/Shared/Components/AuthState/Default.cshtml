@model NotedWeb.Pages.Shared.Components.AuthState.AuthStateViewModel

@if (Model.IsLoggedIn)
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/Logout">Logout</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/Login">Login</a>
    </li>
}
