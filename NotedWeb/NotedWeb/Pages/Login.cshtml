@page
@model NotedWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-bg">
    <div class="auth-shape shape-1"></div>
    <div class="auth-shape shape-2"></div>
    <div class="container position-relative z-1">
        <div class="row justify-content-center min-vh-80 align-items-center py-5">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="card login-card border-0">
                    <div class="login-card-header text-center">
                        <div class="brand-icon mx-auto mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                            </svg>
                        </div>
                        <h1 class="h3 fw-bold text-white mb-1">Welcome back</h1>
                        <p class="text-white-50 mb-0">Sign in to continue</p>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        @if (Model.ShowSuccess)
                        {
                            <div class="text-center mb-4">
                                <div class="success-circle mx-auto mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                                    </svg>
                                </div>
                                <h2 class="fw-bold h4">You're signed in</h2>
                                <p class="text-muted">@Model.SuccessMessage</p>
                                <a href="@Model.ReturnUrl" class="btn btn-primary btn-lg w-100">Continue to app</a>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger d-flex align-items-center" role="alert">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
                                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                    </svg>
                                    <div>@Model.ErrorMessage</div>
                                </div>
                            }

                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.LoginName" class="form-control" autocomplete="username" aria-required="true" placeholder="name" />
                                    <label asp-for="Input.LoginName">Login</label>
                                    <span asp-validation-for="Input.LoginName" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3 position-relative">
                                    <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="current-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password">Password</label>
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-decoration-none px-3" id="togglePassword" tabindex="-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </button>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="rememberMe">
                                        <label class="form-check-label text-muted small" for="rememberMe">Remember me</label>
                                    </div>
                                    <a href="#" class="text-primary small text-decoration-none">Forgot password?</a>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                                    <span class="spinner-border spinner-border-sm d-none" id="loginSpinner" aria-hidden="true"></span>
                                    Sign in
                                </button>
                            </form>

                            <div class="text-center mt-4">
                                <p class="text-muted small mb-0">Don't have an account? <a href="#" class="text-primary text-decoration-none fw-semibold">Get started</a></p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toggle = document.getElementById('togglePassword');
        const input = document.getElementById('passwordInput');
        if (toggle && input) {
            toggle.addEventListener('click', function () {
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
            });
        }
        const form = document.querySelector('form.needs-validation');
        if (form) {
            form.addEventListener('submit', function () {
                const spinner = document.getElementById('loginSpinner');
                if (spinner) spinner.classList.remove('d-none');
            });
        }
    </script>
}

